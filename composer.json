{
  "name": "ruvelo/magento2-security-alerts",
  "description": "Security alerts in the Magento admin and by email when your Magento version or an installed extension has a known vulnerability, loudest when it is exploited in the wild.",
  "type": "magento2-module",
  "license": "MIT",
  "keywords": ["magento2", "magento", "mage-os", "security", "advisories", "vulnerabilities", "cisa-kev", "apsb", "cosmicsting"],
  "homepage": "https://github.com/Ruvelo/magento2-security-alerts",
  "authors": [
    {
      "name": "François Bultez",
      "homepage": "https://github.com/francoisbultez",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "~8.2.0||~8.3.0||~8.4.0",
    "composer/semver": "^3.0",
    "magento/framework": "^103.0.7",
    "magento/module-backend": "^102.0.7",
    "magento/module-config": "^101.2",
    "magento/module-email": "^101.1",
    "magento/module-store": "^101.1"
  },
  "require-dev": {
    "bitexpert/phpstan-magento": "^0.32",
    "magento/magento-coding-standard": "*",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.mage-os.org/",
      "only": ["magento/*", "mage-os/*"]
    }
  ],
  "autoload": {
    "files": ["registration.php"],
    "psr-4": {
      "Ruvelo\\SecurityAlerts\\": ""
    }
  },
  "config": {
    "sort-packages": true,
    "audit": {
      "block-insecure": false
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "magento/composer-dependency-version-audit-plugin": false,
      "mage-os/composer-dependency-version-audit-plugin": false,
      "magento/magento-composer-installer": false,
      "php-http/discovery": false
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 -P4 php -l -n > /dev/null",
    "cs": "phpcs --standard=Magento2 --extensions=php,phtml --severity=10 --ignore=vendor,Test,.github,.phpstan.cache,.phpunit.cache .",
    "analyse": "phpstan analyse --memory-limit=1G --no-progress",
    "check": ["@lint", "@cs", "@analyse", "@test"]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/Ruvelo/magento2-security-alerts/issues",
    "source": "https://github.com/Ruvelo/magento2-security-alerts"
  }
}
